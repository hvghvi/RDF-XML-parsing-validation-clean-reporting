import xml.etree.ElementTree as ET

# Parse the XML file
tree = ET.parse('data/TD Basic Golden InstanceSet.xml')

# Get the root element
root = tree.getroot()

# Loop through every element in the tree, print its tag and text
for element in root.iter():
    if element.get('{http://www.w3.org/1999/02/22-rdf-syntax-ns#}about') is not None:
        print(element.get('{http://www.w3.org/1999/02/22-rdf-syntax-ns#}about'))
    else:
        print(element.tag, element.text if element.text else "N/A")
        print(element.attrib)
