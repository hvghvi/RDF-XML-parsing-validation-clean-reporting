import xml.etree.ElementTree as ET

# Parse the XML file
tree = ET.parse('data/TD Basic Golden InstanceSet.xml')

# Get the root element
root = tree.getroot()


current_object = None
#loop through each uuid group and print out its attributes
for element in root.iter():
    uuid = element.get('{http://www.w3.org/1999/02/22-rdf-syntax-ns#}about')

    if uuid:
        current_object = element
        print()
        print(element.tag, uuid)
    else:
        print(element.tag, element.text if element.text else "N/A")
       